# CertiFlow Frontend Environment Configuration
# Copy this file to .env.local for local development

# Base URL of the backend FastAPI service
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Issuer Secret for client-side certificate cryptographic verification
# CERTIFLOW_ISSUER_SECRET=your-secure-issuer-secret-key-change-in-production
