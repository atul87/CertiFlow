# Production Dockerfile for CertiFlow Distributed Background Workers (ARQ)
FROM python:3.12-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Final worker stage
FROM python:3.12-slim AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/home/appuser/.local/bin:$PATH \
    APP_ENV=production

# Install font rendering libraries and dependencies for Pillow/ReportLab
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-dejavu-core \
    fonts-liberation \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user
RUN groupadd -g 10001 appgroup && \
    useradd -u 10000 -g appgroup -m -s /bin/bash appuser

# Copy installed python dependencies from builder
COPY --from=builder /root/.local /home/appuser/.local

# Copy application source code
COPY --chown=appuser:appgroup . .

# Ensure storage directories exist
RUN mkdir -p /app/storage/certificates /app/storage/templates /app/storage/imports /app/storage/fonts && \
    chown -R appuser:appgroup /app/storage /home/appuser

USER appuser

# Graceful termination handling: SIGTERM forwarded by Docker to ARQ
STOPSIGNAL SIGTERM

CMD ["arq", "app.workers.worker.WorkerSettings"]
