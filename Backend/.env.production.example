# ==============================================================================
# CertiFlow SaaS Platform — Production Environment Configuration Template
# ==============================================================================

# Application Identity & Deployment
APP_NAME=CertiFlow
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
APP_BASE_URL=https://app.certiflow.io
PUBLIC_VERIFY_URL=https://verify.certiflow.io

# Security & Cryptography
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-very-long-and-secure-random-hex-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# 32-byte Fernet key for database sensitive fields encryption: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-base64-fernet-key-32-bytes=

# Production Managed MongoDB (e.g. MongoDB Atlas Replica Set with TLS)
MONGODB_URI=mongodb+srv://certiflow_app:STRONG_PASSWORD@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=CertiFlowProd
MONGODB_DATABASE=certiflow_production

# Production Managed Redis (Cluster or Sentinel with TLS and password auth)
REDIS_URL=rediss://default:STRONG_REDIS_PASSWORD@redis-prod.internal:6379/0

# Object Storage (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_TYPE=s3
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET_NAME=certiflow-production-assets
S3_ACCESS_KEY_ID=AKIA_PRODUCTION_KEY
S3_SECRET_ACCESS_KEY=PRODUCTION_SECRET_KEY

# Email Notification Provider (SendGrid / AWS SES / Resend)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.production_key_here
DEFAULT_FROM_EMAIL=no-reply@certiflow.io
DEFAULT_FROM_NAME="CertiFlow Platform"

# SaaS Billing & Subscription Engine (Stripe / Razorpay / Mock)
BILLING_PROVIDER=mock
BILLING_SECRET_KEY=sk_live_replace_with_provider_secret_key
BILLING_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret
BILLING_CURRENCY=INR
DEFAULT_TRIAL_DAYS=14
BILLING_GRACE_PERIOD_DAYS=7

# Production CORS Allowed Origins
CORS_ORIGINS=["https://certiflow.io","https://app.certiflow.io","https://verify.certiflow.io"]

# Rate Limiting & Resource Throttles
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_ANON_PER_MINUTE=60
MAX_ACTIVE_JOBS_PER_ORG=5
WORKER_CONCURRENCY=10
